   "position": [
    200,
    200
   ]
  },
  {
   "parameters": {
    "url": "=https://{{$env.ERPNEXT_DOMAIN}}/api/method/synapse_core.api.aggregation_due",
    "method": "POST",
    "sendHeaders": true,
    "headerParameters": {
     "parameters": [
      {
       "name": "Authorization",
       "value": "=token {{$env.ERPNEXT_API_KEY}}:{{$env.ERPNEXT_API_SECRET}}"
      },
      {
       "name": "Content-Type",
       "value": "application/json"
      }
     ]
    },
    "sendBody": true,
    "specifyBody": "json",
    "jsonBody": "={{JSON.stringify({})}}",
    "options": {}
   },
   "id": "n102",
   "name": "Ritmo — Grupos vencidos (MAX_EVENTS ou MAX_WAIT)",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4,
   "position": [
    440,
    200
   ]
  },
  {
   "parameters": {
    "jsCode": "\nconst due = ($input.first().json.message || []);\nif (!due.length) return [{ json: { vazio: true } }];\nreturn due.map(g => ({ json: g }));"
   },
   "id": "n103",
   "name": "Um item por grupo",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    680,
    200
   ]
  },
  {
   "parameters": {
    "conditions": {
     "boolean": [
      {
       "value1": "={{$json.vazio !== true}}",
       "value2": true
      }
     ]
    }
   },
   "id": "n104",
   "name": "Há grupo?",
   "type": "n8n-nodes-base.if",
   "typeVersion": 1,
   "position": [
    900,
    200
   ]
  },
  {
   "parameters": {
    "url": "=https://{{$env.ERPNEXT_DOMAIN}}/api/method/synapse_core.api.aggregation_flush",
    "method": "POST",
    "sendHeaders": true,
    "headerParameters": {
     "parameters": [
      {
       "name": "Authorization",
       "value": "=token {{$env.ERPNEXT_API_KEY}}:{{$env.ERPNEXT_API_SECRET}}"
      },
      {
       "name": "Content-Type",
       "value": "application/json"
      }
     ]
    },
    "sendBody": true,
    "specifyBody": "json",
    "jsonBody": "={{JSON.stringify({agg_key: $json.agg_key})}}",
    "options": {}
   },
   "id": "n105",
   "name": "Ritmo — Flush do grupo",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4,
   "position": [
    1120,
    100
   ]
  },
  {
   "parameters": {
    "url": "={{$env.LYRA_CENTRAL_URL}}/v1/decide",
    "method": "POST",
    "sendHeaders": true,
    "headerParameters": {
     "parameters": [
      {
       "name": "Content-Type",
       "value": "application/json"
      },
      {
       "name": "Authorization",
       "value": "=Bearer {{$env.LYRA_API_KEY}}"
      },
      {
       "name": "X-Tenant-ID",
       "value": "={{$env.LYRA_TENANT_ID}}"
      }
     ]
    },
    "sendBody": true,
    "specifyBody": "json",
    "jsonBody": "={{JSON.stringify({trigger: 'aggregate', events: $json.message.events})}}",
    "options": {
     "timeout": 60000
    }
   },
   "id": "n106",
   "name": "Lyra Central — Decide (lote agregado)",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4,
   "position": [
    1360,
    100
   ]
  },
  {
   "parameters": {
    "jsCode": "\nconst g = $node['Um item por grupo'].json;\nconst flush = $node['Ritmo — Flush do grupo'].json.message || {};\nconst ops = ($input.first().json.operations || []);\nif (!ops.length) return [{ json: { event_ids: flush.event_ids, sem_operacao: true } }];\nreturn ops.map(o => ({ json: { event_ids: flush.event_ids, operation: o, sem_operacao: false } }));"
   },
   "id": "n107",
   "name": "Monta Operações do Lote",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    1600,
    100
   ]
  },
  {
   "parameters": {
    "conditions": {
     "boolean": [
      {
       "value1": "={{$json.sem_operacao === false}}",
       "value2": true
      }
     ]
    }
   },
