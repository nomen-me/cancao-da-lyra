    "sendQuery": true,
    "queryParameters": {
     "parameters": [
      {
       "name": "filters",
       "value": "=[[\"item_code\",\"in\",{{JSON.stringify(($json.data.items||[]).map(i=>i.item_code))}}]]"
      },
