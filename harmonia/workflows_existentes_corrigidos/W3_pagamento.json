  {
   "parameters": {
    "jsCode": "const doc = $json;\nlet raw = String($node['Extrai Dados da Fatura'].json.mobile_no || '').replace(/\\D/g, '');\nlet telefone_normalizado;\nif (raw.startsWith('55') && raw.length >= 12) {\n  telefone_normalizado = '+' + raw;\n} else if (raw.length === 10 || raw.length === 11) {\n  telefone_normalizado = '+55' + raw;\n} else {\n  telefone_normalizado = '+' + raw;\n}\nreturn [{ json: { ...doc, telefone_normalizado } }];\n"
   },
   "id": "normaliza-tel-0-whatsapp-envia-pix",
   "name": "Normaliza Telefone (WhatsApp — Envia Pix)",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
