    "jsCode": "const body = $input.first().json.body || $input.first().json;\nconst doc = body.doc || body;\n\nreturn [{\n  json: {\n    invoice_id: doc.name,\n    customer: doc.customer,\n    customer_name: doc.customer_name,\n    mobile_no: (doc.contact_mobile || '').replace(/\\D/g, ''),\n    valor: parseFloat(doc.grand_total || 0).toFixed(2),\n    vencimento: doc.due_date || new Date(Date.now() + 24*60*60*1000).toISOString().split('T')[0]\n  }\n}];"
