   "id": "busca-recursos-digitais",
   "name": "Ritmo — Busca Recurso Digital dos Itens",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4,
   "position": [
    1200,
    500
   ],
   "continueOnFail": true,
   "notes": "custom_recurso_digital: único campo novo modelado, direto no Item (texto livre — link, código ou instrução). Sem pool, sem alocação por venda — se um produto precisar de código único no futuro, essa é a peça isolada a acrescentar, não agora."
  },
  {
   "parameters": {
    "jsCode": "const fatura = $node['ERPNext — Busca Dados da Fatura'].json.data;\nconst itensComRecurso = $input.first().json.data || [];\n\nconst mapa = {};\nfor (const i of itensComRecurso) { if (i.custom_recurso_digital) mapa[i.item_code] = i.custom_recurso_digital; }\n\nconst recursos = (fatura.items || [])\n  .filter(i => mapa[i.item_code])\n  .map(i => `• ${i.item_name || i.item_code}: ${mapa[i.item_code]}`);\n\nlet telRaw = String(fatura.contact_mobile || '').replace(/\\D/g, '');\nlet telefone = null;\nif (telRaw) telefone = telRaw.startsWith('55') && telRaw.length >= 12 ? '+' + telRaw : '+55' + telRaw;\nconst email = fatura.contact_email || null;\n\nconst canal = telefone ? 'whatsapp' : (email ? 'email' : 'nenhum');\n\nreturn [{\n  json: {\n    temRecurso: recursos.length > 0,\n    mensagem: `✅ Aqui está o que você comprou, *${fatura.customer_name}*:\\n\\n${recursos.join('\\n')}\\n\\nPedido #${fatura.name}.`,\n    telefone, email, canal, invoiceName: fatura.name\n  }\n}];\n"
   },
