  {
   "parameters": {
    "jsCode": "const doc = $json;\nlet raw = String(($json.contact_mobile || '').replace(/\\D/g, '') || '').replace(/\\D/g, '');\nlet telefone_normalizado;\nif (raw.startsWith('55') && raw.length >= 12) {\n  telefone_normalizado = '+' + raw;\n} else if (raw.length === 10 || raw.length === 11) {\n  telefone_normalizado = '+55' + raw;\n} else {\n  telefone_normalizado = '+' + raw;\n}\nreturn [{ json: { ...doc, telefone_normalizado } }];\n"
   },
   "id": "normaliza-tel-2-whatsapp-notifica-cancelamento",
   "name": "Normaliza Telefone (WhatsApp — Notifica Cancelamento)",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    0,
    0
   ]
  },
  {
   "parameters": {
    "jsCode": "const doc = $json;\nlet raw = String(($json.data?.contact_mobile || '').replace(/\\D/g, '') || '').replace(/\\D/g, '');\nlet telefone_normalizado;\nif (raw.startsWith('55') && raw.length >= 12) {\n  telefone_normalizado = '+' + raw;\n} else if (raw.length === 10 || raw.length === 11) {\n  telefone_normalizado = '+55' + raw;\n} else {\n  telefone_normalizado = '+' + raw;\n}\nreturn [{ json: { ...doc, telefone_normalizado } }];\n"
   },
   "id": "normaliza-tel-3-whatsapp-confirma-pagamento",
   "name": "Normaliza Telefone (WhatsApp — Confirma Pagamento)",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    0,
    0
   ]
  },
  {
   "parameters": {
    "jsCode": "const crypto = require('crypto');\nconst assinaturaRecebida = ($json.headers && $json.headers['x-infinitepay-signature']) || '';\nconst corpoBruto = JSON.stringify($json.body || {});\nconst secreto = $env.INFINITEPAY_WEBHOOK_SECRET || '';\nconst assinaturaEsperada = crypto.createHmac('sha256', secreto).update(corpoBruto).digest('hex');\nconst valido = !!secreto && assinaturaRecebida === assinaturaEsperada;\nreturn [{ json: { ...$json, assinatura_valida: valido } }];\n"
   },
   "id": "valida-assinatura-ip",
   "name": "Valida Assinatura InfinitePay",
