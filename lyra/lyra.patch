-module.exports = { streamChat, toGeminiContents };
+/**
+ * Decisão autônoma (não-streaming). A LLM só PROPÕE chamadas de ferramenta; nada é executado aqui.
+ * O conteúdo do evento NÃO é logado (regra de zero log).
+ */
+async function decideOnce({ events, plan, context = {} }) {
+  const { autonomyToolDeclarations, AUTONOMY_SYSTEM_INSTRUCTION } = require('../config/autonomyTools');
+  const contents = [{ role: 'user', parts: [{ text: JSON.stringify({ eventos: events, plano: plan || null, contexto: context }) }] }];
+  const response = await ai.models.generateContent({
+    model: env.gemini.model,
+    contents,
+    config: { systemInstruction: AUTONOMY_SYSTEM_INSTRUCTION, tools: [{ functionDeclarations: autonomyToolDeclarations }] },
+  });
+  const um = response.usageMetadata;
+  return {
+    functionCalls: response.functionCalls || [],
+    usage: um ? { promptTokens: um.promptTokenCount, completionTokens: um.candidatesTokenCount, totalTokens: um.totalTokenCount } : null,
+  };
+}
+
+module.exports = { streamChat, toGeminiContents, decideOnce };
diff --git a/lyra-central-api/test/autonomy.test.js b/lyra-central-api/test/autonomy.test.js
new file mode 100644
index 0000000..066d605
--- /dev/null
+++ b/lyra-central-api/test/autonomy.test.js
@@ -0,0 +1,73 @@
+'use strict';
+const test = require('node:test');
+const assert = require('node:assert');
+const a = require('../src/services/autonomy');
+
+const ev = (o = {}) => ({ event_id: 'ev-1', root_event_id: 'root-1', chain_id: 'ch-1', causal_depth: 2, entity_type: 'Item', entity_id: 'X', event_type: 'item.stock_changed', state_version: 42, payload: {}, ...o });
+const call = { name: 'criar_venda', arguments: { customer: 'C1', itens: [{ produto_id: 'X', quantidade: 1, preco_unitario: 10 }] } };
+
+test('operation_id e deterministico (reprocessar o evento nao duplica acao)', () => {
+  assert.strictEqual(a.deriveOperationId('ev-1', 0, 'criar_venda'), a.deriveOperationId('ev-1', 0, 'criar_venda'));
+  assert.notStrictEqual(a.deriveOperationId('ev-1', 0, 'criar_venda'), a.deriveOperationId('ev-1', 1, 'criar_venda'));
+  assert.notStrictEqual(a.deriveOperationId('ev-1', 0, 'criar_venda'), a.deriveOperationId('ev-2', 0, 'criar_venda'));
+});
+test('decision_state_version = versao do evento sobre o qual a decisao foi tomada', () => {
+  assert.deepStrictEqual(a.buildBasis(ev(), null), [{ entity_type: 'Item', entity_id: 'X', decision_state_version: 42 }]);
+});
+test('evento sem state_version nao gera decisao', () => assert.throws(() => a.buildBasis(ev({ state_version: undefined }), null), /state_version/));
+test('conflito: nova decisao usa a versao ATUAL devolvida pelo Ritmo', () => {
+  const e = ev({ event_type: 'concurrency_conflict', payload: { current_context: [{ entity_type: 'Item', entity_id: 'X', expected_state_version: 42, current_state_version: 43 }] } });
+  const plan = a.controlPlan(e);
+  assert.strictEqual(plan.kind, 'REDECIDE');
+  assert.strictEqual(a.buildBasis(e, plan)[0].decision_state_version, 43);
+});
+test('intent_expired -> reconfirmacao ao cliente, NUNCA operacao', () => {
+  const e = ev({ event_type: 'intent_expired', origin_operation_id: 'op-old', payload: { operation_id: 'op-old', conversa_id: '77' } });
+  const plan = a.controlPlan(e);
+  assert.strictEqual(plan.kind, 'RECONFIRM');
+  const n = a.notificationFor(plan, e);
+  assert.strictEqual(n.kind, 'reconfirm_intent'); assert.strictEqual(n.conversa_id, '77');
+});
+test('aprovacao pendente notifica em nota privada', () => {
+  const e = ev({ event_type: 'approval_requested', payload: { operation_id: 'op-9' } });
+  assert.strictEqual(a.notificationFor(a.controlPlan(e), e).private, true);
+});
+test('evento comum nao tem plano de controle (vai para a LLM); origem LYRA nao e suprimida', () => {
+  assert.strictEqual(a.controlPlan(ev({ origin_actor: 'LYRA' })), null);
+});
+test('proposta fora da allowlist e rejeitada', () => assert.strictEqual(a.validateProposal({ name: 'apagar_banco', arguments: {} }).ok, false));
+test('cancelar_venda sem motivo e rejeitada', () => assert.strictEqual(a.validateProposal({ name: 'cancelar_venda', arguments: { id_pedido: 'P1' } }).ok, false));
+test('criar_venda com item incompleto e rejeitada', () => assert.strictEqual(a.validateProposal({ name: 'criar_venda', arguments: { customer: 'C', itens: [{ produto_id: 'X' }] } }).ok, false));
+test('operacao carrega lineage, versao e NAO fixa TTL (fica na config do Ritmo)', () => {
+  const e = ev();
+  const op = a.buildOperation({ event: e, call, index: 0, basis: a.buildBasis(e, null), intentCreatedAt: '2026-09-29 10:00:00.000' });
+  assert.strictEqual(op.origin_actor, 'LYRA');
+  assert.strictEqual(op.basis[0].decision_state_version, 42);
+  assert.deepStrictEqual([op.lineage.event_id, op.lineage.root_event_id, op.lineage.chain_id, op.lineage.causal_depth], ['ev-1', 'root-1', 'ch-1', 2]);
+  assert.strictEqual('intent_ttl' in op, false);
+});
+test('intent_created_at vem do cliente quando o evento traz (reconciliacao nao renova)', () => {
+  assert.strictEqual(a.intentCreatedAt(ev({ payload: { intent_created_at: 'T0' } }), 'AGORA'), 'T0');
+  assert.strictEqual(a.intentCreatedAt(ev(), 'AGORA'), 'AGORA');
+});
+test('lote: base = maior state_version por entidade; chave deterministica independe da ordem', () => {
+  const e1 = ev({ event_id: 'a', state_version: 5 }), e2 = ev({ event_id: 'b', state_version: 7 }), e3 = ev({ event_id: 'c', entity_id: 'Y', state_version: 2 });
+  const b = a.buildBatchBasis([e1, e2, e3]);
+  assert.deepStrictEqual(b.find((x) => x.entity_id === 'X').decision_state_version, 7);
+  assert.strictEqual(b.length, 2);
+  assert.strictEqual(a.batchKey([e1, e2, e3]), a.batchKey([e3, e1, e2]));
+  assert.notStrictEqual(a.batchKey([e1, e2]), a.batchKey([e1, e3]));
+  assert.strictEqual(a.batchKey([e1]), 'a');
+});
+test('lote: operation_id depende do lote, nao de um evento so', () => {
+  const e1 = ev({ event_id: 'a' }), e2 = ev({ event_id: 'b' });
+  const k = a.batchKey([e1, e2]);
+  const o1 = a.buildOperation({ event: e2, call, index: 0, basis: a.buildBatchBasis([e1, e2]), intentCreatedAt: 'T', key: k });
+  const o2 = a.buildOperation({ event: e2, call, index: 0, basis: a.buildBatchBasis([e2, e1]), intentCreatedAt: 'T', key: a.batchKey([e2, e1]) });
+  assert.strictEqual(o1.operation_id, o2.operation_id);
+});
+test('emite JSON de operacao para o teste de contrato com o Ritmo real', () => {
+  const e = ev({ event_id: 'contrato-1' });
+  const op = a.buildOperation({ event: e, call: { name: 'criar_venda', arguments: { customer: 'CLI-CANCAO', itens: [{ produto_id: 'ITEM-CANCAO', quantidade: 1, preco_unitario: 10 }] } }, index: 0, basis: [{ entity_type: 'Item', entity_id: 'ITEM-CANCAO', decision_state_version: 0 }], intentCreatedAt: new Date().toISOString().slice(0, 23).replace('T', ' ') });
+  require('fs').writeFileSync(process.env.CONTRACT_OUT || '/tmp/lyra_op_contract.json', JSON.stringify(op));
+});
