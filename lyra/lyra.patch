diff --git a/lyra-central-api/src/routes/decide.js b/lyra-central-api/src/routes/decide.js
new file mode 100644
index 0000000..0a45b96
--- /dev/null
+++ b/lyra-central-api/src/routes/decide.js
@@ -0,0 +1,65 @@
+'use strict';
+
+const express = require('express');
+const { v4: uuidv4 } = require('uuid');
+const { logCallMetadata, logger } = require('../utils/logger');
+const { ErrorCodes } = require('../utils/errorCodes');
+const autonomy = require('../services/autonomy');
+const geminiService = require('../services/geminiService');
+
+const router = express.Router();
+
+/**
+ * POST /v1/decide  (Harmonia -> Lyra, disparado por evento do Outbox ou lote agregado)
+ * Devolve JSON: { plan, operations[], notifications[] }. Zero log de conteúdo (metadados apenas).
+ */
+router.post('/decide', async (req, res) => {
+  const { event, events, trigger, context } = req.body || {};
+  const evs = event ? [event] : Array.isArray(events) ? events : [];
+  if (evs.length === 0) {
+    return res.status(400).json({ error: ErrorCodes.INVALID_PAYLOAD, message: 'event ou events e obrigatorio.', correlation_id: req.correlationId });
+  }
+  const callId = `decide_${req.tenantId}_${uuidv4().slice(0, 8)}`;
+  const nowIso = new Date().toISOString().slice(0, 23).replace('T', ' ');
+  const operations = [];
+  const notifications = [];
+  let usedLlm = false;
+  try {
+    // 1) eventos de controle: tratamento fixo (nao passam pela LLM, exceto REDECIDE)
+    const llmEvents = [];
+    for (const ev of evs) {
+      const plan = autonomy.controlPlan(ev);
+      if (plan && plan.kind !== 'REDECIDE') {
+        const n = autonomy.notificationFor(plan, ev);
+        if (n) notifications.push(n);
+        continue;
+      }
+      llmEvents.push({ ev, plan });
+    }
+    // 2) demais eventos: UMA decisão sobre o lote completo (envelopes do Outbox, sem formato paralelo)
+    if (llmEvents.length) {
+      const batch = llmEvents.map((x) => x.ev);
+      const redecide = llmEvents.find((x) => x.plan && x.plan.kind === 'REDECIDE');
+      const basis = redecide ? autonomy.buildBasis(redecide.ev, redecide.plan) : autonomy.buildBatchBasis(batch);
+      const last = batch.reduce((a, b) => ((b.seq || 0) >= (a.seq || 0) ? b : a), batch[0]);   // pai causal: o evento mais recente do lote
+      const key = autonomy.batchKey(batch);
+      const { functionCalls, usage } = await geminiService.decideOnce({ events: batch, plan: redecide ? redecide.plan : null, context });
+      usedLlm = true;
+      let idx = 0;
+      for (const call of functionCalls) {
+        const shaped = { name: call.name, arguments: call.args || {} };
+        const v = autonomy.validateProposal(shaped);
+        if (!v.ok) { logger.warn({ event: 'autonomy_proposal_rejected', tenant_id: req.tenantId, call_id: callId, reason: v.reason }); continue; }
+        operations.push(autonomy.buildOperation({ event: last, call: shaped, index: idx++, basis, intentCreatedAt: autonomy.intentCreatedAt(last, nowIso), key }));
+      }
+      logCallMetadata({ tenantId: req.tenantId, callId, event: 'decide_completed', tokens: usage ? usage.totalTokens : null, status: 'ok', extra: { correlation_id: req.correlationId, trigger, batch_size: batch.length } });
+    }
+    return res.status(200).json({ call_id: callId, operations, notifications, used_llm: usedLlm });
+  } catch (err) {
+    logger.error({ event: 'decide_failed', tenant_id: req.tenantId, call_id: callId, message: err.message });
+    // infra_failure: o Harmonia NAO marca PROCESSED (resposta != 2xx) e o Outbox reentrega.
+    return res.status(502).json({ error: ErrorCodes.INFRA_FAILURE, call_id: callId, correlation_id: req.correlationId });
+  }
+});
+
+module.exports = router;
diff --git a/lyra-central-api/src/services/autonomy.js b/lyra-central-api/src/services/autonomy.js
new file mode 100644
index 0000000..ef00693
--- /dev/null
+++ b/lyra-central-api/src/services/autonomy.js
@@ -0,0 +1,118 @@
+'use strict';
+
+/**
+ * Autonomia da Lyra (Canção) — parte DETERMINÍSTICA. Sem I/O, sem env, sem SDK.
+ * A LLM só propõe ações; tudo aqui valida, amarra à versão de estado
+ * (decision_state_version) e à linhagem causal antes de a Harmonia
+ * entregar ao Ritmo. Quem executa/rejeita é a camada de execução do Ritmo.
+ */
+const crypto = require('crypto');
+
+// Ações que a Lyra pode PROPOR. Autorização real é reforçada no Ritmo (allowlist configurável).
+const ACTION_SCHEMAS = {
+  criar_venda: { required: ['customer', 'itens'], itemRequired: ['produto_id', 'quantidade', 'preco_unitario'] },
+  confirmar_venda: { required: ['id_pedido'] },
+  cancelar_venda: { required: ['id_pedido', 'motivo'] },
+};
+
+const CONTROL = {
+  REDECIDE: ['concurrency_conflict', 'context_changed'],
+  RECONFIRM: ['intent_expired'],
+  NOTIFY_APPROVER: ['approval_requested'],
+  NOTIFY_FAILURE: ['approval_rejected', 'operation_failed', 'operation_unauthorized'],
+};
+
+/** operation_id determinístico: reprocessar o MESMO evento gera as MESMAS operações (idempotência ponta a ponta). */
+function deriveOperationId(eventId, index, action) {
+  const h = crypto.createHash('sha256').update(`${eventId}|${index}|${action}`).digest('hex').slice(0, 32);
+  return `op_${h}`;
+}
+
+/** Eventos de controle têm tratamento fixo; a LLM não decide o que fazer com INTENT_EXPIRED. */
+function controlPlan(event) {
+  const t = event && event.event_type;
+  if (CONTROL.REDECIDE.includes(t)) return { kind: 'REDECIDE', previous_operation_id: event.origin_operation_id, context: (event.payload || {}).current_context || [] };
+  if (CONTROL.RECONFIRM.includes(t)) return { kind: 'RECONFIRM', operation_id: (event.payload || {}).operation_id || event.origin_operation_id };
+  if (CONTROL.NOTIFY_APPROVER.includes(t)) return { kind: 'NOTIFY_APPROVER', operation_id: (event.payload || {}).operation_id };
+  if (CONTROL.NOTIFY_FAILURE.includes(t)) return { kind: 'NOTIFY_FAILURE', operation_id: (event.payload || {}).operation_id, event_type: t };
+  return null;
+}
+
+/** Base de versão da decisão: a versão sobre a qual a decisão FOI tomada (nunca a "atual" lida depois). */
+function buildBasis(event, plan) {
+  if (plan && plan.kind === 'REDECIDE' && plan.context.length) {
+    return plan.context.map((c) => ({ entity_type: c.entity_type, entity_id: c.entity_id, decision_state_version: c.current_state_version }));
+  }
+  if (event.state_version === undefined || event.state_version === null) throw new Error('evento sem state_version: nao ha base para decidir');
+  return [{ entity_type: event.entity_type, entity_id: String(event.entity_id), decision_state_version: event.state_version }];
+}
+
+function validateProposal(call) {
+  const schema = ACTION_SCHEMAS[call && call.name];
+  if (!schema) return { ok: false, reason: `acao nao permitida: ${call && call.name}` };
+  const a = call.arguments || {};
+  for (const k of schema.required) if (a[k] === undefined || a[k] === null || a[k] === '') return { ok: false, reason: `argumento obrigatorio ausente: ${k}` };
+  if (schema.itemRequired) {
+    if (!Array.isArray(a.itens) || a.itens.length === 0) return { ok: false, reason: 'itens deve ser lista nao vazia' };
+    for (const it of a.itens) for (const k of schema.itemRequired) if (it[k] === undefined || it[k] === null) return { ok: false, reason: `item sem ${k}` };
+  }
+  return { ok: true };
+}
+
+/** Monta a operação enviada ao Ritmo. intent_ttl só é enviado se fornecido: o TTL padrão vive na config do Ritmo. */
+function buildOperation({ event, call, index, basis, intentCreatedAt, intentTtl, key }) {
+  const v = validateProposal(call);
+  if (!v.ok) throw new Error(v.reason);
+  const op = {
+    operation_id: deriveOperationId(key || event.event_id, index, call.name),
+    action: call.name,
+    args: call.arguments,
+    basis,
+    origin_actor: 'LYRA',
+    intent_created_at: intentCreatedAt,
+    lineage: {
+      event_id: event.event_id, root_event_id: event.root_event_id, chain_id: event.chain_id,
+      causal_depth: event.causal_depth, entity_type: event.entity_type, entity_id: String(event.entity_id),
+    },
+  };
+  if (intentTtl) op.intent_ttl = intentTtl;
+  return op;
+}
+
+/** Base de versão para um LOTE: uma entrada por entidade, com a MAIOR state_version vista no lote
+ *  (a decisão foi tomada sobre o que o lote mostrava; se a entidade avançou, o Ritmo rejeita). */
+function buildBatchBasis(events) {
+  const m = new Map();
+  for (const e of events) {
+    if (e.state_version === undefined || e.state_version === null) throw new Error('evento sem state_version: nao ha base para decidir');
+    const k = `${e.entity_type}::${e.entity_id}`;
+    const cur = m.get(k);
+    if (!cur || e.state_version > cur.decision_state_version) m.set(k, { entity_type: e.entity_type, entity_id: String(e.entity_id), decision_state_version: e.state_version });
+  }
+  return [...m.values()];
+}
+
+/** Chave determinística do lote: reprocessar o MESMO conjunto gera as MESMAS operações. */
+function batchKey(events) {
+  if (events.length === 1) return events[0].event_id;
+  const ids = events.map((e) => e.event_id).sort().join(',');
+  return 'batch:' + crypto.createHash('sha256').update(ids).digest('hex').slice(0, 24);
+}
+
+/** Momento da intenção: o do cliente (se o evento o traz) ou o da decisão. Nunca "renovado" por reconciliação. */
+function intentCreatedAt(event, nowIso) {
+  return (event.payload && event.payload.intent_created_at) || nowIso;
+}
+
+function notificationFor(plan, event) {
+  const conversa = (event.payload || {}).conversa_id || null;
+  if (plan.kind === 'RECONFIRM') return { kind: 'reconfirm_intent', conversa_id: conversa, operation_id: plan.operation_id,
+    text: 'Passou um tempo desde o seu pedido e preciso confirmar com você antes de finalizar. Você ainda deseja seguir com ele?' };
+  if (plan.kind === 'NOTIFY_APPROVER') return { kind: 'approval_needed', conversa_id: conversa, operation_id: plan.operation_id, private: true,
+    text: `Aprovação necessária para a operação ${plan.operation_id}. Abra o Painel para aprovar ou rejeitar.` };
+  if (plan.kind === 'NOTIFY_FAILURE') return { kind: 'operation_problem', conversa_id: conversa, operation_id: plan.operation_id, private: true,
+    text: `A operação ${plan.operation_id} não foi executada (${plan.event_type}).` };
+  return null;
+}
+
+module.exports = { buildBatchBasis, batchKey, ACTION_SCHEMAS, CONTROL, deriveOperationId, controlPlan, buildBasis, validateProposal, buildOperation, intentCreatedAt, notificationFor };
