+'use strict';
+
+/** Tools de AÇÃO AUTÔNOMA (mutações). Separadas de tools.js (consultas do chat). A Lyra só PROPÕE; o Ritmo decide. */
+const autonomyToolDeclarations = [
+  {
+    name: 'criar_venda',
+    description: 'Propõe criar uma venda (Sales Order) para um cliente com itens e preços.',
+    parametersJsonSchema: {
+      type: 'object',
+      properties: {
+        customer: { type: 'string' }, conversa_id: { type: 'string' },
+        itens: { type: 'array', items: { type: 'object', properties: { produto_id: { type: 'string' }, quantidade: { type: 'number' }, preco_unitario: { type: 'number' } }, required: ['produto_id', 'quantidade', 'preco_unitario'] } },
+      },
+      required: ['customer', 'itens'],
+    },
+  },
+  { name: 'confirmar_venda', description: 'Propõe confirmar (submeter) um pedido existente.', parametersJsonSchema: { type: 'object', properties: { id_pedido: { type: 'string' }, conversa_id: { type: 'string' } }, required: ['id_pedido'] } },
+  { name: 'cancelar_venda', description: 'Propõe cancelar um pedido. Exige motivo. Sempre passa por aprovação humana.', parametersJsonSchema: { type: 'object', properties: { id_pedido: { type: 'string' }, motivo: { type: 'string' }, conversa_id: { type: 'string' } }, required: ['id_pedido', 'motivo'] } },
+];
+
+const AUTONOMY_SYSTEM_INSTRUCTION = `Você é o módulo de decisão autônoma de uma loja. Recebe UM evento operacional (ou um lote agregado) e o estado atual das entidades.
+Decida se alguma ação é necessária. Se não for, não chame nenhuma ferramenta.
+Regras: nunca invente dados; use apenas identificadores presentes no evento/contexto; se faltar informação, não aja.
+Você apenas PROPÕE ações — a execução é validada por outra camada.`;
+
+module.exports = { autonomyToolDeclarations, AUTONOMY_SYSTEM_INSTRUCTION };
